@baseUrl = http://localhost:8080/api/users
@updateUserId = 4
### 1. 查询存在的用户
GET {{baseUrl}}/1
Accept: application/json

> {%
    client.test("查询用户详情返回统一成功响应", function () {
        client.assert(response.status === 200);
        client.assert(response.body.code === 0);
        client.assert(response.body.message === "操作成功");
        client.assert(response.body.data.id === 1);
        client.assert(response.body.data.username === "alice");
    });
%}

### 2. GET 不存在用户，预期 40401
GET {{baseUrl}}/999999
Accept: application/json

> {%
    client.test("不存在用户返回统一业务异常", function () {
        client.assert(response.status === 404, "HTTP 状态码应为 404");
        client.assert(response.body.code === 40401, "业务码应为 40401");
        client.assert(
            response.body.message === "用户不存在",
            "错误消息不正确"
        );
        client.assert(response.body.data === null, "data 应为 null");
    });
%}

