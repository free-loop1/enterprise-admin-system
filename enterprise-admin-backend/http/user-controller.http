### 45. 对用户详情接口使用不支持的 PATCH，预期 40500
PATCH {{baseUrl}}/1
Content-Type: application/json

{
  "nickname": "Should Not Update"
}

> {%
    client.test("HTTP 状态码为 405", function () {
        client.assert(response.status === 405);
    });

    client.test("业务错误码为 40500", function () {
        client.assert(response.body.code === 40500);
    });

    client.test("错误消息正确", function () {
        client.assert(response.body.message === "请求方法不支持");
    });

    client.test("data 为 null", function () {
        client.assert(response.body.data === null);
    });
%}
