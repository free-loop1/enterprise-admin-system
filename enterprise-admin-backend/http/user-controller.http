@baseUrl = http://localhost:8080/api/users

### 1. GET 已存在用户，预期 200 和 JSON
GET {{baseUrl}}/1
Accept: application/json

> {%
    client.test("查询用户详情成功", function () {
        client.assert(response.status === 200, "状态码应为 200");
        client.assert(response.body.id === 1, "用户 ID 应为 1");
        client.assert(response.body.username === "alice", "用户名应为 alice");
        client.assert(response.body.password === undefined, "不应返回 password");
        client.assert(response.body.deleted === undefined, "不应返回 deleted");
    });
%}

### 2. GET 不存在用户，预期 404
GET {{baseUrl}}/999999
Accept: application/json

> {%
    client.test("不存在的用户返回 404", function () {
        client.assert(response.status === 404, "状态码应为 404");
    });
%}

### 3. PUT 修改用户，预期 200
PUT {{baseUrl}}/1001
Content-Type: application/json

{
  "username": "Alice"
}

### 4. DELETE 用户，预期 204 且响应体为空
DELETE {{baseUrl}}/1001

### 5. POST 真实创建用户，预期 201 和 Location
POST {{baseUrl}}
Content-Type: application/json

{
  "username": "user_{{$uuid}}",
  "password": "Test@123456",
  "nickname": "HTTP Test User",
  "phone": "13900139000",
  "email": "http-test@example.com"
}

> {%
    client.test("创建用户成功", function () {
        client.assert(response.status === 201, "状态码应为 201");

        const location = response.headers.valueOf("Location");
        client.assert(
            location !== null && location.startsWith("/api/users/"),
            "Location 应指向新用户详情"
        );

        client.global.set("createdUserLocation", location);
    });
%}

### 6. GET 刚创建的用户，预期 200 且不泄露密码
GET http://localhost:8080{{createdUserLocation}}
Accept: application/json

> {%
    client.test("查询刚创建的用户成功", function () {
        client.assert(response.status === 200, "状态码应为 200");
        client.assert(response.body.password === undefined, "不应返回 password");
        client.assert(response.body.deleted === undefined, "不应返回 deleted");
        client.assert(response.body.status === 1, "未传 status 时应使用数据库默认值 1");
    });
%}