### 9. POST 真实创建用户，预期 201 和 Location
POST {{baseUrl}}
Content-Type: application/json

{
  "username": "user_{{$random.alphanumeric(20)}}",
  "password": "Test@123456",
  "nickname": "HTTP Test User",
  "phone": "13900139000",
  "email": "http-test@example.com"
}

> {%
    client.test("创建用户成功", function () {
        client.assert(response.status === 201, "状态码应为 201");
        client.assert(response.body.code === 0, "业务码应为 0");
        client.assert(response.body.data > 0, "data 应为新用户 ID");

        const location = response.headers.valueOf("Location");
        client.assert(
            location !== null && location.startsWith("/api/users/"),
            "Location 应指向新用户详情"
        );
        client.assert(
            location.endsWith("/" + response.body.data),
            "Location 中的 ID 应与响应 data 一致"
        );

        client.global.set("createdUserLocation", location);
        client.global.set("deleteUserId", response.body.data);
    });
%}

### 10. GET 刚创建的用户，预期 200 且不泄露密码
GET http://localhost:8080{{createdUserLocation}}
Accept: application/json

> {%
    client.test("查询刚创建的用户成功", function () {
        client.assert(response.status === 200, "状态码应为 200");
        client.assert(response.body.data.password === undefined, "不应返回 password");
        client.assert(response.body.data.deleted === undefined, "不应返回 deleted");
        client.assert(response.body.data.status === 1, "未传 status 时应使用数据库默认值 1");
    });
%}

### 11. GET 默认分页，预期第 1 页、每页 10 条
GET {{baseUrl}}
Accept: application/json

> {%
    client.test("默认分页查询成功", function () {
        client.assert(response.status === 200, "状态码应为 200");
        client.assert(response.body.code === 0, "业务码应为 0");
        client.assert(Array.isArray(response.body.data.records), "records 应为数组");
        client.assert(response.body.data.page === 1, "默认页码应为 1");
        client.assert(response.body.data.size === 10, "默认每页数量应为 10");
        client.assert(response.body.data.total >= 0, "total 不应小于 0");
        client.assert(response.body.data.pages >= 0, "pages 不应小于 0");

        response.body.data.records.forEach(function (user) {
            client.assert(user.password === undefined, "不应返回 password");
            client.assert(user.deleted === undefined, "不应返回 deleted");
        });
    });
%}

### 12. GET 指定每页 2 条
GET {{baseUrl}}?page=1&size=2
Accept: application/json

> {%
    client.test("指定分页大小成功", function () {
        client.assert(response.status === 200, "状态码应为 200");
        client.assert(response.body.data.page === 1, "当前页应为 1");
        client.assert(response.body.data.size === 2, "每页数量应为 2");
        client.assert(
            response.body.data.records.length <= 2,
            "当前页记录数不应超过 2"
        );
    });
%}

### 13. GET 按用户名模糊搜索
GET {{baseUrl}}?page=1&size=10&username=alice
Accept: application/json

> {%
    client.test("按用户名搜索成功", function () {
        client.assert(response.status === 200, "状态码应为 200");
        client.assert(response.body.data.records.length > 0, "应查到 alice");

        response.body.data.records.forEach(function (user) {
            client.assert(
                user.username.includes("alice"),
                "返回的用户名应包含 alice"
            );
        });
    });
%}

